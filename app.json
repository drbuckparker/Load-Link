{
  "expo": {
    "name": "LoadLink",
    "slug": "loadlink",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "loadlink",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.8",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/06835a51-8023-416f-948f-d8450c3495bf"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#161a22"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "app.replit.loadlink",
      "buildNumber": "26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "versionCode": 18,
      "package": "com.loadlink.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0k24WGEPooosI-AB0dkewtiBTp_DScdI"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#161a22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidPlayConsoleFixes",
      [
        "expo-router",
        {
          "origin": "https://loadlinklive.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LoadLink uses your location to verify you are at the job site when you clock in and out, to show nearby trucking jobs sorted by distance, to auto-fill pickup and drop-off addresses when you post a job, and — only while you are clocked in — to remind you if you leave the job site without clocking out. For example, when you tap Clock In at a delivery site, your current location confirms your arrival.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/truckhorn.wav",
            "./assets/sounds/cashregister.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.react.fabric.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.rnmaps.** { *; }\n-keep public class com.horcrux.svg.** { *; }\n-keep class expo.modules.notifications.** { *; }\n-keep class com.reactnativekeyboardcontroller.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://loadlinklive.com/"
      },
      "eas": {
        "projectId": "06835a51-8023-416f-948f-d8450c3495bf"
      }
    },
    "owner": "load-link"
  }
}
